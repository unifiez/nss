# ------------------------------------------------------------------
# Copy to `.env.local` and fill in the blanks. `.env.local` is gitignored.
# ------------------------------------------------------------------

# MongoDB connection string.
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
#   Local:  mongodb://127.0.0.1:27017
MONGODB_URI=

# Database name to use inside that connection string.
MONGODB_DB=nss_profiles

# Admin login for /admin. Both are required; login is rejected while
# either is empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 16 characters. Sessions are rejected while it is empty.
SESSION_SECRET=

# Public origin of the site. Used to build the URLs that QR codes point at.
# In production set this to your real domain, e.g. https://nss.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
